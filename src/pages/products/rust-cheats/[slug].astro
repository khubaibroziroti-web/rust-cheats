---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllProductSlugs, getProductPage, productHub } from '../../../data/products';
import { pageTitle } from '../../../config/seo';
import { getPageSeoEntry } from '../../../config/pageSeo';
import { breadcrumbSchema, productSchema } from '../../../utils/schema';
import ProductDetail from '../../../components/ProductDetail.astro';
import { checkoutUrlWithPlan, getProductPlans } from '../../../data/productPricing';

export function getStaticPaths() {
  return getAllProductSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const product = getProductPage(slug!);

if (!product) {
  return Astro.redirect(productHub.path);
}

const pagePath = `${productHub.path}${product.slug}/`;
const seoEntry = getPageSeoEntry(pagePath);
const metaTitle = seoEntry?.title ?? pageTitle(`Buy ${product.title}`);
const metaDescription =
  seoEntry?.description ??
  `Buy ${product.title} Rust cheats — ${product.desc}`;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Products', path: productHub.path },
  { name: product.title, path: pagePath },
];
const productOffers = getProductPlans(product.slug).map((plan) => ({
  url: checkoutUrlWithPlan(product.buyUrl, plan.id),
  price: plan.priceUsd,
  priceCurrency: 'USD',
}));
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  jsonLd={[
    productSchema({
      name: product.title,
      description: metaDescription,
      url: pagePath,
      offerUrl: product.buyUrl,
      offers: productOffers,
      image: product.images[0]?.src,
      sku: product.slug,
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <ProductDetail product={product} breadcrumbs={breadcrumbs} />
</BaseLayout>
