---
import type { ProductPage } from '../../data/products';
import SectionHeader from '../SectionHeader.astro';
import Icon from '../icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { Badge } from '@/components/starwind/badge';
import { checkoutUrlWithPlan, formatPlanPrice, getProductPlans } from '../../data/productPricing';

interface Props {
  product: ProductPage;
}

const { product } = Astro.props;
const defaultPlan = getProductPlans(product.slug)[0]!;
---

<section
  class="border-b border-border bg-muted/20 py-12 md:py-16"
  aria-labelledby="product-highlights-title"
>
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader
      eyebrow="At a glance"
      title="Key capabilities"
      desc={`What ${product.name} focuses on before you open the full module list.`}
      titleId="product-highlights-title"
    />

    <div class="product-detail__inline-row mt-10 flex flex-wrap gap-2.5 md:gap-3">
      {
        product.features.map((feature) => (
          <Badge variant="outline" size="lg" class="rounded-full px-4 py-2 text-sm font-medium leading-snug">
            {feature}
          </Badge>
        ))
      }
    </div>

    {
      product.more > 0 && (
        <p class="product-detail__text-center mt-6 text-sm text-muted-foreground">
          Plus {product.more} additional modules in the operator portal—see the full list below.
        </p>
      )
    }

    <div class="product-detail__inline-row mt-8 flex flex-wrap gap-3">
      <Button type="button" data-scroll-target="product-features" variant="outline" size="sm" class="rounded-full">
        All modules
        <Icon name="chevronDown" size={16} />
      </Button>
      <Button
        as="a"
        href={checkoutUrlWithPlan(product.buyUrl, defaultPlan.id)}
        variant="primary"
        size="sm"
        class="rounded-full"
        rel="sponsored noopener"
      >
        Buy now — {formatPlanPrice(defaultPlan.priceUsd)}
        <Icon name="arrowRight" size={16} />
      </Button>
    </div>
  </div>
</section>
