---
import type { ProductPage } from '../../data/products';
import {
  checkoutUrlWithPlan,
  formatPlanPrice,
  getProductPlans,
} from '../../data/productPricing';
import Icon from '../icons/Icon.astro';
import ProductIconWell from './ProductIconWell.astro';
import { Button } from '@/components/starwind/button';
import { RadioGroup, RadioGroupItem } from '@/components/starwind/radio-group';

interface Props {
  product: ProductPage;
}

const { product } = Astro.props;
const plans = getProductPlans(product.slug);
const defaultPlan = plans[0]!;
const isSinglePlan = plans.length === 1;
---

<aside
  class="product-checkout text-left lg:sticky lg:top-24"
  aria-labelledby={`checkout-${product.slug}`}
  data-product-checkout
  data-product-slug={product.slug}
  data-selected-plan={defaultPlan.id}
  data-buy-url={product.buyUrl}
  data-plans={JSON.stringify(plans)}
>
  <div class="overflow-hidden rounded-2xl border border-primary/35 bg-card shadow-md ring-1 ring-primary/15">
    <div class="card-title-band flex items-center justify-start gap-3 px-5 py-4 text-left">
      <ProductIconWell name="acqPackage" iconSize={20} class="bg-primary/15" />
      <div class="min-w-0 text-left">
        <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Checkout</p>
        <h2 id={`checkout-${product.slug}`} class="text-base font-semibold leading-snug">
          {isSinglePlan ? 'Purchase option' : 'Select subscription'}
        </h2>
      </div>
    </div>

    <div class="space-y-5 px-5 pb-5 pt-5">
      <RadioGroup
        defaultValue={defaultPlan.id}
        name={`plan-${product.slug}`}
        legend={isSinglePlan ? 'Purchase option' : 'Select subscription'}
        class="flex flex-col gap-2"
      >
        {
          plans.map((plan) => (
            <label class="flex cursor-pointer items-center justify-between gap-3 rounded-xl border border-border bg-background p-3.5 transition-colors has-data-checked:border-primary has-data-checked:bg-primary/10">
              <span class="flex min-w-0 items-center gap-3">
                <RadioGroupItem value={plan.id} variant="primary" aria-label={`${plan.label}, ${formatPlanPrice(plan.priceUsd)}`} />
                <span class="flex min-w-0 flex-wrap items-center gap-2 text-sm font-medium">
                  {plan.label}
                  {plan.id === 'monthly' && !isSinglePlan && (
                    <span class="rounded-full bg-primary px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-primary-foreground">
                      Popular
                    </span>
                  )}
                </span>
              </span>
              <span class="shrink-0 text-sm font-semibold tabular-nums text-foreground">
                {formatPlanPrice(plan.priceUsd)}
              </span>
            </label>
          ))
        }
      </RadioGroup>

      <div class="flex items-end justify-between gap-3 border-t border-border pt-4">
        <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Total</span>
        <p class="text-right font-[family-name:var(--font-heading)] text-2xl font-bold leading-none text-primary">
          <span data-checkout-total>{formatPlanPrice(defaultPlan.priceUsd)}</span>
          <span class="block text-sm font-medium text-muted-foreground" data-checkout-note>
            {defaultPlan.priceNote}
          </span>
        </p>
      </div>

      <Button
        as="a"
        href={checkoutUrlWithPlan(product.buyUrl, defaultPlan.id)}
        variant="primary"
        size="lg"
        class="w-full rounded-xl"
        data-checkout-buy
        rel="sponsored noopener"
      >
        <span>Buy now — <span data-checkout-button-price>{formatPlanPrice(defaultPlan.priceUsd)}</span></span>
        <Icon name="arrowRight" size={17} />
      </Button>

      <ul class="grid grid-cols-3 gap-2 text-center text-[11px] leading-tight text-muted-foreground" aria-label="Purchase benefits">
        <li class="flex flex-col items-center gap-1.5">
          <Icon name="zap" size={15} class="text-primary" />
          <span>Instant access</span>
        </li>
        <li class="flex flex-col items-center gap-1.5">
          <Icon name="refresh" size={15} class="text-primary" />
          <span>Updates included</span>
        </li>
        <li class="flex flex-col items-center gap-1.5">
          <Icon name="headphones" size={15} class="text-primary" />
          <span>Setup support</span>
        </li>
      </ul>

      <p class="text-xs leading-relaxed text-muted-foreground">
        Partner checkout in USD. Review the <a class="font-medium text-foreground underline underline-offset-2 hover:text-primary" href="#product-requirements">requirements</a>
        and <a class="font-medium text-foreground underline underline-offset-2 hover:text-primary" href="/affiliate-disclosure/">affiliate disclosure</a> before purchase.
      </p>
    </div>
  </div>
</aside>

<script>
  const initProductCheckoutPanels = () => {
    document.querySelectorAll('[data-product-checkout]').forEach((root) => {
      if (root.hasAttribute('data-checkout-bound')) return;
      root.setAttribute('data-checkout-bound', '');

      const buyUrl = root.getAttribute('data-buy-url');
      const plansRaw = root.getAttribute('data-plans');
      if (!buyUrl || !plansRaw) return;

      type Plan = { id: string; priceUsd: number; priceNote: string };
      let plans: Plan[] = [];
      try {
        plans = JSON.parse(plansRaw) as Plan[];
      } catch {
        return;
      }

      const group = root.querySelector('[data-sw-radio-group]');
      const totalEl = root.querySelector('[data-checkout-total]');
      const noteEl = root.querySelector('[data-checkout-note]');
      const buttonPriceEl = root.querySelector('[data-checkout-button-price]');
      const buyBtn = root.querySelector<HTMLAnchorElement>('[data-checkout-buy]');
      if (!group || !totalEl || !noteEl || !buttonPriceEl || !buyBtn) return;

      const sync = () => {
        const planId = group.getAttribute('data-value') ?? plans[0]?.id;
        const plan = plans.find((p) => p.id === planId) ?? plans[0];
        if (!plan) return;

        totalEl.textContent = `$${plan.priceUsd}`;
        noteEl.textContent = plan.priceNote;
        buttonPriceEl.textContent = `$${plan.priceUsd}`;
        root.setAttribute('data-selected-plan', plan.id);
        const separator = buyUrl.includes('?') ? '&' : '?';
        buyBtn.href = `${buyUrl}${separator}plan=${plan.id}`;
      };

      group.addEventListener('click', () => window.setTimeout(sync, 0));
      const observer = new MutationObserver(sync);
      observer.observe(group, { attributes: true, attributeFilter: ['data-value'] });
      sync();
    });
  };

  initProductCheckoutPanels();
  document.addEventListener('astro:after-swap', initProductCheckoutPanels);
</script>
