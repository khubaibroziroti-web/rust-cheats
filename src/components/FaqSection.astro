---
import type { SiteFaqItem, FaqTopic } from '../data/faq';
import SectionHeader from './SectionHeader.astro';
import Icon from './icons/Icon.astro';
import ChevronDown from '@tabler/icons/outline/chevron-down.svg';

interface Props {
  items: SiteFaqItem[];
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  titleId?: string;
  showFilters?: boolean;
  filterTopics?: FaqTopic[];
  centered?: boolean;
  /** FAQ column alignment (product pages use left) */
  contentAlign?: 'left' | 'center';
  id?: string;
  class?: string;
}

const {
  items,
  eyebrow = 'FAQ',
  title = 'Rust cheats FAQ',
  subtitle = 'Compatibility, bans and cheat access — straight answers before you buy.',
  titleId = 'faq-heading',
  showFilters = false,
  filterTopics,
  centered = false,
  contentAlign = 'center',
  id: sectionId,
  class: className,
} = Astro.props;

const topicLabels: Record<FaqTopic, string> = {
  all: 'All',
  plans: 'Plans',
  esp: 'ESP wallhack / ESP',
  scripts: 'Scripts',
  safety: 'Safety',
  products: 'Products',
  blog: 'Blog',
  setup: 'Setup',
};

const filters = filterTopics ?? (['all', 'plans', 'esp', 'scripts', 'safety', 'products'] as FaqTopic[]);
---

<section
  id={sectionId}
  class:list={['py-16 md:py-24', className]}
  aria-labelledby={titleId}
  data-faq-section={showFilters ? '' : undefined}
>
  <div class="mx-auto max-w-6xl px-5">
    <div class:list={[contentAlign === 'center' && 'mx-auto max-w-3xl', contentAlign === 'left' && 'product-detail__narrow max-w-3xl']}>
    <SectionHeader
      eyebrow={eyebrow}
      title={title}
      desc={subtitle}
      titleId={titleId}
      centered={centered}
    />

    {
      showFilters && (
        <div
          class:list={[
            'mt-8 flex flex-wrap gap-2',
            contentAlign === 'center' ? 'justify-center' : 'justify-start',
          ]}
          data-faq-filters
        >
          {filters.map((topic, i) => (
            <button
              type="button"
              class:list={[
                'faq-filter-chip rounded-full border border-border px-3 py-1.5 text-xs font-medium text-muted-foreground transition-colors hover:border-primary hover:text-foreground',
                { 'is-active': i === 0 },
              ]}
              data-faq-filter={topic}
            >
              {topicLabels[topic]}
            </button>
          ))}
        </div>
      )
    }

    <div class="mt-8 w-full" data-faq-list>
      {items.map((faq, i) => (
        <div data-faq-topic={faq.topic}>
          <details class="faq-native-item" name={`faq-${titleId}`}>
            <summary class="faq-native-trigger">
              <span class="flex items-center gap-2">
                <Icon name={faq.icon} size={16} class="shrink-0" />
                <span>{faq.q}</span>
              </span>
              <ChevronDown class="faq-native-chevron size-5 shrink-0" aria-hidden="true" />
            </summary>
            <div class="faq-native-content">
              <div class="prose prose-sm dark:prose-invert max-w-none text-muted-foreground" set:html={faq.aHtml ?? faq.a} />
            </div>
          </details>
        </div>
      ))}
    </div>
    </div>
  </div>
</section>
