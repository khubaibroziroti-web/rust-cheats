---
import type { ProductAcquisition } from '../data/products';
import { acquisitionStepIcons } from '../data/sectionIcons';
import Icon from './icons/Icon.astro';
import { Badge } from '@/components/starwind/badge';
import { Button } from '@/components/starwind/button';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/starwind/card';

interface Props {
  title: string;
  subtitle?: string;
  acquisition: ProductAcquisition;
  buyUrl: string;
  badge?: string;
  tier?: string;
  category?: string;
  variant?: 'essential' | 'popular' | 'limited';
}

const { title, subtitle, acquisition, buyUrl, badge, tier, category, variant } = Astro.props;
const hasMeta = Boolean(badge || tier || category || variant);
---

<div class="space-y-10">
  <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
    <div class="max-w-2xl space-y-4">
      {
        hasMeta && (
          <div class="flex flex-wrap gap-2">
            {badge && <Badge>{badge}</Badge>}
            {tier && <Badge variant="outline">{tier}</Badge>}
            {category && <Badge variant="secondary">{category}</Badge>}
            {variant === 'popular' && <Badge variant="default">Popular</Badge>}
          </div>
        )
      }
      <h1 class="text-3xl font-bold uppercase md:text-4xl">{title}</h1>
      {subtitle && <p class="text-lg text-muted-foreground">{subtitle}</p>}
    </div>

    <Card class="w-full max-w-sm shrink-0">
      <CardContent class="space-y-3 pt-6">
        <Button as="a" href={buyUrl} variant="primary" class="w-full" rel="sponsored noopener">
          Buy Now
          <Icon name="arrowRight" size={17} />
        </Button>
        <p class="text-center text-xs text-muted-foreground">Instant access · support team setup support</p>
      </CardContent>
    </Card>
  </div>

  <section aria-labelledby="product-acquisition-heading">
    <Card>
      <CardHeader>
        <CardTitle id="product-acquisition-heading" class="normal-case">{acquisition.title}</CardTitle>
      </CardHeader>
      <CardContent>
        <ol class="grid gap-4 md:grid-cols-2">
          {acquisition.steps.map((step, index) => (
            <li class="group flex gap-3 rounded-lg border border-border p-4">
              <span class="group/step flex size-9 shrink-0 items-center justify-center rounded-md bg-primary/10" aria-hidden="true">
                <Icon name={acquisitionStepIcons[index] ?? 'check'} size={18} />
              </span>
              <div>
                <span class="text-xs font-semibold text-primary">{step.num}</span>
                <p class="font-medium text-foreground">{step.title}</p>
                <p class="text-sm text-muted-foreground">{step.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </CardContent>
    </Card>
  </section>
</div>
