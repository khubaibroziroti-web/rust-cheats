---
import { t } from '../i18n';
import { Separator } from '@/components/starwind/separator';

const resourceLinks = [
  { href: '/blog/', label: 'Blog archive', ariaLabel: 'Blog' },
  { href: '/products/rust-cheats/elite/', label: 'Elite cheats', ariaLabel: 'Elite cheats' },
  { href: '/products/rust-cheats/', label: 'Products & utilities', ariaLabel: 'Products' },
  { href: '/support/', label: t.footer.support },
];

const legalLinks = [
  { href: '/about/', label: t.footer.about },
  { href: '/privacy/', label: t.footer.privacy },
  { href: '/terms/', label: t.footer.terms },
  { href: '/affiliate-disclosure/', label: 'Affiliate disclosure' },
];

const shareUrl = encodeURIComponent(`https://getrustcheat.com${Astro.url.pathname}`);
const shareLinks = [
  { href: `https://twitter.com/intent/tweet?url=${shareUrl}`, label: 'Share on X' },
  { href: `https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`, label: 'Share on Facebook' },
  { href: `https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`, label: 'Share on LinkedIn' },
];
---

<footer class="border-t border-border bg-muted/30 py-16">
  <div class="mx-auto max-w-6xl px-5">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="space-y-4">
        <a href="/" class="inline-flex items-center gap-2.5 font-[family-name:var(--font-heading)] text-lg font-bold" aria-label={t.ui.homeAria}>
          <img src="/dayz-logo-64.webp" alt="Rust Cheats logo" width="32" height="32" class="rounded-md" />
          <span aria-hidden="true"><span class="brand-rust">Rust</span><span class="brand-cheats">Cheats</span></span>
        </a>
        <p class="text-sm text-muted-foreground">{t.footer.tagline}</p>
        <nav aria-label="Share this page">
          <ul class="flex flex-wrap gap-x-3 gap-y-1">
            {shareLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-xs text-muted-foreground hover:text-primary"
                  target="_blank"
                  rel="nofollow noopener noreferrer"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <nav aria-label={t.footer.explore}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.explore}</p>
        <ul class="mt-3 space-y-2">
          {t.footer.exploreLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-muted-foreground hover:text-primary"
                {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.support}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.support}</p>
        <ul class="mt-3 space-y-2">
          {resourceLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-muted-foreground hover:text-primary">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.legal}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.legal}</p>
        <ul class="mt-3 space-y-2">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-muted-foreground hover:text-primary">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <Separator class="my-8" />
    <p class="text-left text-sm text-muted-foreground">
      &copy; {new Date().getFullYear()} {t.site.name} · {t.site.domain}
    </p>
  </div>
</footer>
