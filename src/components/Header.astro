---
import { t } from '../i18n';
import { checkoutPath } from '../config/checkout';
import { Button } from '@/components/starwind/button';
import AnimatedThemeSwitch from './AnimatedThemeSwitch.astro';
import Icon from './icons/Icon.astro';
import SlideRevealButton from './SlideRevealButton.astro';

import type { IconName } from './icons/types';

const navIcons: Record<string, IconName> = {
  Products: 'navProducts',
  Blog: 'navBlog',
  Forum: 'messageCircle',
  FAQ: 'navFaq',
  Support: 'navSupport',
};

const purchaseUrl = checkoutPath('rust');
const currentPath = Astro.url.pathname.replace(/\/index\.html$/, '').replace(/\/$/, '') || '/';
const isActivePath = (href: string) => {
  const targetPath = href.replace(/\/index\.html$/, '').replace(/\/$/, '') || '/';
  return targetPath === '/' ? currentPath === '/' : currentPath === targetPath || currentPath.startsWith(`${targetPath}/`);
};
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50">
  <div class="flex justify-center px-3 pt-3 sm:px-4 sm:pt-4" data-floating-nav>
    <div
      class="pointer-events-auto relative flex h-14 w-full max-w-6xl items-center justify-between gap-3 rounded-2xl border border-border/40 bg-background/35 px-4 text-foreground shadow-md shadow-black/5 backdrop-blur-2xl supports-[backdrop-filter]:bg-background/25 dark:border-white/10 dark:bg-background/20 dark:shadow-black/25 sm:px-5 lg:h-[3.75rem]"
    >
    <a
      href="/"
      class:list={[
        'home-brand-link inline-flex min-w-0 items-center rounded-lg font-[family-name:var(--font-heading)] text-lg font-bold tracking-wide transition-colors',
        isActivePath('/') && 'is-active',
      ]}
      aria-label={t.ui.homeAria}
      aria-current={isActivePath('/') ? 'page' : undefined}
      data-nav-link
    >
      <img src="/dayz-logo-64.webp" alt="Rust Cheats logo" width="28" height="28" class="mr-2 size-7 shrink-0 rounded-md" />
      <span class="truncate" aria-hidden="true"><span class="brand-rust">Rust</span><span class="brand-cheats">Cheats</span></span>
    </a>

    <nav class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-6 lg:flex" aria-label="Primary">
      {t.nav.map((link) => (
        <a
          href={link.href}
          class:list={[
            'nav-link inline-flex items-center gap-1.5 rounded-md px-2 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:text-primary',
            isActivePath(link.href) && 'is-active',
          ]}
          data-nav-link
          aria-current={isActivePath(link.href) ? 'page' : undefined}
          {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
        >
          <Icon name={navIcons[link.label] ?? 'navFeatures'} size={16} />
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <div class="hidden items-center sm:flex">
        <SlideRevealButton href={purchaseUrl} class="hidden lg:inline-flex">
          {t.ui.browseCheats}
        </SlideRevealButton>
        <div class="nav-action-divider hidden items-center px-3 lg:flex" aria-hidden="true">
          <span class="block h-9 w-px bg-border"></span>
        </div>
        <AnimatedThemeSwitch size="md" ariaLabel={t.ui.themeLight} class="inline-flex" />
      </div>

      <details class="mobile-nav lg:hidden" data-mobile-nav>
        <summary class="mobile-nav__trigger inline-flex size-9 items-center justify-center rounded-lg border border-border/80 bg-background/50 text-foreground transition-colors hover:bg-muted lg:hidden" aria-label={t.ui.menuOpen}>
          <Icon name="menu" size={20} />
        </summary>
        <div class="mobile-nav__backdrop" data-mobile-nav-backdrop aria-hidden="true"></div>
        <div class="mobile-nav__panel fixed inset-y-0 right-0 z-[60] flex w-[min(100vw-2rem,20rem)] flex-col gap-4 border-l bg-background p-4 shadow-lg" data-mobile-nav-panel>
          <div class="flex min-h-8 items-center justify-between pr-10">
            <span class="font-[family-name:var(--font-heading)] font-semibold"><span class="brand-rust">Rust</span><span class="brand-cheats">Cheats</span></span>
            <button type="button" class="mobile-nav__close rounded-md p-1 text-muted-foreground hover:bg-muted hover:text-foreground" data-mobile-nav-close aria-label={t.ui.menuClose}>
              <Icon name="x" size={20} />
            </button>
          </div>
          <nav class="flex flex-col gap-1" aria-label="Mobile">
            {t.nav.map((link) => (
              <a
                href={link.href}
                class:list={[
                  'nav-link flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-primary',
                  isActivePath(link.href) && 'is-active',
                ]}
                data-nav-link
                aria-current={isActivePath(link.href) ? 'page' : undefined}
                {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
              >
                <Icon name={navIcons[link.label] ?? 'navFeatures'} size={16} />
                {link.label}
              </a>
            ))}
          </nav>
          <Button as="a" href={purchaseUrl} variant="primary" class="w-full justify-center" aria-label={t.ui.checkoutAria} rel="sponsored noopener">
            {t.ui.browseCheatsMobile}
          </Button>
          <div class="flex justify-center pt-1">
            <AnimatedThemeSwitch size="sm" ariaLabel={t.ui.themeLight} />
          </div>
        </div>
      </details>
    </div>
    </div>
  </div>
</header>
