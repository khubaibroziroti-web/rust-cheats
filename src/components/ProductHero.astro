---
import type { ProductAcquisition, ProductOverview, ProductSlide } from '../data/products';
import { acquisitionStepIcons } from '../data/sectionIcons';
import Icon from './icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/starwind/card';

interface Props {
  overview: ProductOverview;
  acquisition: ProductAcquisition;
  buyUrl: string;
  sliderId?: string;
  images?: ProductSlide[];
}

const { overview, acquisition, buyUrl } = Astro.props;
---

<div class="grid gap-10 lg:grid-cols-2">
  <div class="space-y-4 text-left">
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-primary">Overview</p>
    <h1 class="text-3xl font-bold uppercase md:text-4xl">{overview.title}</h1>
    {overview.paragraphs.map((p) => (
      <p class="text-muted-foreground leading-relaxed">{p}</p>
    ))}
  </div>

  <Card>
    <CardHeader>
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-primary">Acquisition</p>
      <CardTitle class="normal-case">{acquisition.title}</CardTitle>
    </CardHeader>
    <CardContent class="space-y-6">
      <Button as="a" href={buyUrl} variant="primary" class="w-full" rel="sponsored noopener">
        Buy Now
        <Icon name="arrowRight" size={17} />
      </Button>
      <ol class="space-y-4">
        {acquisition.steps.map((step, i) => (
          <li class="group flex gap-3">
            <span class="group/step flex size-9 shrink-0 items-center justify-center rounded-md bg-primary/10" aria-hidden="true">
              <Icon name={acquisitionStepIcons[i] ?? 'check'} size={18} />
            </span>
            <div>
              <p class="font-medium text-foreground">{step.title}</p>
              <p class="text-sm text-muted-foreground">{step.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </CardContent>
  </Card>
</div>
